{
  "name": "saas-kit",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@tailwindcss/postcss": "^4",
      "@types/node": "^26.6.4",
      "@types/react": "^19",
      "@types/react-dom": "^19",
      "better-auth": "1.7.7",
      "dotenv": "^18.0.5",
      "react": "19.3.0",
      "react-dom": "19.3.0",
      "tailwindcss": "^4",
      "typescript": "^6.0.3",
      "zod": "^4.6.5"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "format": "turbo format",
    "db:push": "turbo -F @saas-kit/db db:push",
    "db:generate": "turbo -F @saas-kit/db db:generate",
    "db:migrate": "turbo -F @saas-kit/db db:migrate",
    "ui:add": "bunx --bun shadcn@latest add -c packages/ui",
    "clean": "rm -rf .turbo && turbo run clean",
    "prepare": "husky"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@saas-kit/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "turbo": "2.11.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
